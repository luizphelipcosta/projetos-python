def jogo_da_velha():
    tabuleiro = [str(i) for i in range(1, 10)]
    jogador = "X"

    for turno in range(9):
        print(f"\n{tabuleiro[0]} | {tabuleiro[1]} | {tabuleiro[2]}")
        print(f"{tabuleiro[3]} | {tabuleiro[4]} | {tabuleiro[5]}")
        print(f"{tabuleiro[6]} | {tabuleiro[7]} | {tabuleiro[8]}")

        jogada = int(input(f"Jogador {jogador}, escolha uma posição livre: ")) - 1
        if tabuleiro[jogada] not in ["X", "O"]:
            tabuleiro[jogada] = jogador
            # Validação simples de vitória (linha horizontal/vertical/diagonal)
            vitorias = [(0,1,2), (3,4,5), (6,7,8), (0,3,6), (1,4,7), (2,5,8), (0,4,8), (2,4,6)]
            if any(tabuleiro[a] == tabuleiro[b] == tabuleiro[c] == jogador for a, b, c in vitorias):
                print(f"\nJogador {jogador} VENCEU!")
                return
            jogador = "O" if jogador == "X" else "X"
        else:
            print("Posição já ocupada!")
    print("\nEmpate!")

