def sistema_notas_escolares():
    boletim = {}
    while True:
        nome = input("Nome do aluno (ou 'sair'): ").strip()
        if nome.lower() == 'sair': break

        n1 = float(input("Nota 1: "))
        n2 = float(input("Nota 2: "))
        media = (n1 + n2) / 2
        status = "Aprovado" if media >= 7.0 else "Reprovado"
        boletim[nome] = {"Média": media, "Status": status}

    print("\n--- BOLETIM ESCOLAR FINAL ---")
    for aluno, dados in boletim.items():
        print(f"Aluno: {aluno} | Média: {dados['Média']:.1f} | {dados['Status']}")

sistema_notas_escolares()
